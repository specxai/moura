{
  "name": "moura-vitest-minimal-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:results": "node -e \"import { rmSync } from 'node:fs'; rmSync('allure-results', { recursive: true, force: true });\"",
    "pretest": "npm run clean:results",
    "test": "vitest run",
    "verify:results": "node scripts/verify-results.mjs"
  },
  "devDependencies": {
    "@specxai/moura": "^0.1.2",
    "allure-js-commons": "3.12.1",
    "allure-vitest": "3.12.1",
    "vitest": "5.0.0"
  }
}
