{
  "name": "@specxai/moura",
  "version": "0.1.2",
  "description": "Git-native traceability and verification coverage CLI",
  "keywords": [
    "traceability",
    "requirements",
    "verification",
    "testing",
    "allure",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specxai/moura.git"
  },
  "bugs": {
    "url": "https://github.com/specxai/moura/issues"
  },
  "homepage": "https://github.com/specxai/moura#readme",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "bin": {
    "moura": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:allure": "tsx scripts/test-allure.ts",
    "report:allure": "tsx scripts/report-allure.ts && allure generate allure-results --config allurerc.ts --output allure-report && tsx scripts/verify-allure-report.ts",
    "report:moura": "node dist/cli.js report .",
    "quality:site": "tsx scripts/build-quality-site.ts",
    "quality:summary": "tsx scripts/write-ci-summary.ts",
    "test:package": "tsx scripts/package-smoke.ts",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "allure": "^3.17.0",
    "allure-vitest": "^3.12.1",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0"
  }
}
